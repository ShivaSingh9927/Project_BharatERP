{
  "name": "bharaterp-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d && tsx src/db/wait.ts",
    "db:down": "docker compose down",
    "db:reset": "tsx src/db/reset.ts && npm run migrate && npm run seed",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web": "tsx src/web/server.ts",
    "email:import": "tsx src/integrations/runEmailImport.ts",
    "seed:demo": "tsx src/seed/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "office-crypto": "^0.1.0",
    "pg": "^8.13.1",
    "postal-mime": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
