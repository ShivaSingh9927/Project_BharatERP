# Owner connection — runs migrations, owns the schema.
DATABASE_URL=postgres://bharaterp:bharaterp_dev@localhost:55432/bharaterp

# Application runtime connection. This role CANNOT UPDATE or DELETE ledger rows.
# The append-only guarantee (audit-trail.md AT-2, gl-engine.md GL-5) is a
# database permission, not an application convention. Never run the app as owner.
APP_DATABASE_URL=postgres://bharaterp_app:bharaterp_app_dev@localhost:55432/bharaterp
ZAI_API_KEY=            # z.ai layout model (GLM-OCR). Capability only; firm_ai_settings still decides.
