# Owner connection — runs migrations, owns the schema.
DATABASE_URL=postgres://bharaterp:bharaterp_dev@localhost:55432/bharaterp

# Application runtime connection. This role CANNOT UPDATE or DELETE ledger rows.
# The append-only guarantee (audit-trail.md AT-2, gl-engine.md GL-5) is a
# database permission, not an application convention. Never run the app as owner.
APP_DATABASE_URL=postgres://bharaterp_app:bharaterp_app_dev@localhost:55432/bharaterp
ZAI_API_KEY=            # z.ai layout model (GLM-OCR). Capability only; firm_ai_settings still decides.
DEEPSEEK_API=           # DeepSeek key; keep server-side. Never expose it in browser code.
DEEPSEEK_API_FILE=      # Or point to a local secret file instead of copying the key here.
DEEPSEEK_MODEL=deepseek-chat
BANK_STATEMENT_KEY=     # Optional 32-byte base64/hex key. Local installs create a private key file.
# Optional absolute directory for original client files; default app/.data/workspace.
DOCUMENT_WORKSPACE_ROOT=

# Optional Cloudflare Email Worker R2 bridge. Leave unset until the private
# bucket and a bucket-scoped R2 API token exist. The local app polls while on.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_EMAIL_BUCKET=bharaterp-email-intake
# Pilot firm for inbox@ or unknown client references. Known tokens find their firm.
EMAIL_INTAKE_DEFAULT_FIRM_ID=
